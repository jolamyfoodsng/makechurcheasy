# Firebase Admin (service account JSON — set as FIREBASE_SERVICE_ACCOUNT_KEY env var)
FIREBASE_SERVICE_ACCOUNT_KEY=''

# MongoDB
MONGODB_URI="mongodb://localhost:27017/makechurcheasy"

# Cron Jobs — used to authenticate Vercel Cron requests
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Email (SMTP / transactional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
# Local development uses MailDev automatically when `npm run dev` starts.
# Override these only when using a different local SMTP/Web UI port.
DEV_MAILDEV_SMTP_HOST="127.0.0.1"
DEV_MAILDEV_SMTP_PORT="1025"
DEV_MAILDEV_WEB_PORT="1080"

# Paystack (payments)
PAYSTACK_SECRET_KEY=""

# Flutterwave Standard (optional)
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""
FLW_ENCRYPTION_KEY=""
FLW_SECRET_HASH=""
FLW_SUPPORTED_CURRENCIES="NGN,GHS,KES,ZAR,UGX,TZS,RWF,USD,GBP,EUR"

# ── NOWPayments (optional crypto checkout) ──
# Requires an API key, IPN secret, and a public callback URL in production.
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_IPN_CALLBACK_URL="https://<public-api-host>/api/webhooks/nowpayments"
NOWPAYMENTS_DEFAULT_PAY_CURRENCY=""

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_NOTIFICATIONS_ENABLED="true"
TELEGRAM_API_ERROR_ALERTS_ENABLED="true"
TELEGRAM_API_ERROR_COOLDOWN_MS="60000"

# S3 / R2 (media storage)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
