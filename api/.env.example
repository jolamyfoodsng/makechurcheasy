# ═══════════════════════════════════════════════
# MakeChurchEasy — API Environment Variables
# ═══════════════════════════════════════════════
# Copy this file to .env (development) or
# configure in GitHub Environments (production).
# ═══════════════════════════════════════════════

# ── Environment ─────────────────────────────────
# Controls branding and behavior. "development" or "production".
NEXT_PUBLIC_APP_ENV=development
APP_ENV=development

# ── MongoDB ─────────────────────────────────────
# For production, use MongoDB Atlas connection string.
MONGODB_URI="mongodb://localhost:27017/makechurcheasy"

# ── Auth / Session ──────────────────────────────
# Generate AUTH_SECRET with: openssl rand -base64 48
AUTH_SECRET="change-me-generate-a-random-secret"
AUTH_URL="http://localhost:3001"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Firebase Admin ──────────────────────────────
# Full service-account JSON (minified single line)
FIREBASE_SERVICE_ACCOUNT_KEY=''
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── URLs ────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:3004"

# ── Paystack (payments) ─────────────────────────
# Use test keys for development, live keys for production
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."
PAYSTACK_SECRET_KEY="sk_test_..."

# ── Flutterwave Standard (optional) ─────────────────────────────────────────
# Keep the secret key and webhook hash on the API only.
FLW_PUBLIC_KEY="FLWPUBK-..."
FLW_SECRET_KEY="FLWSECK-..."
FLW_ENCRYPTION_KEY="..."
FLW_SECRET_HASH=""
FLW_SUPPORTED_CURRENCIES="NGN,GHS,KES,ZAR,UGX,TZS,RWF,USD,GBP,EUR"
PAYSTACK_BASIC_MONTHLY_PLAN_CODE=""
PAYSTACK_BASIC_YEARLY_PLAN_CODE=""
PAYSTACK_GROWTH_MONTHLY_PLAN_CODE=""
PAYSTACK_GROWTH_YEARLY_PLAN_CODE=""
PAYSTACK_PRO_MONTHLY_PLAN_CODE=""
PAYSTACK_PRO_YEARLY_PLAN_CODE=""

# ── MTN MoMo Collection (optional) ─────────────────────────────────────────
# The checkout uses Collection RequestToPay. Keep all MoMo credentials on the API.
# The linked bc-authorize endpoint is a consent flow, not the charge endpoint.
# Configure one live MoMo Collection market per API deployment. For Nigeria use
# target environment mtnnigeria, country NG, and currency NGN.
MTN_MOMO_ENABLED="false"
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"
MTN_MOMO_COUNTRY_CODE="GH"
MTN_MOMO_ALLOWED_COUNTRIES="GH"
# MTN's shared sandbox uses EUR. Production uses the local currency, e.g. GHS.
MTN_MOMO_CURRENCY="EUR"
MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
# Optional public callback endpoint: https://api.example.com/api/webhooks/mtn-momo
MTN_MOMO_CALLBACK_URL=""
MTN_MOMO_REQUEST_TIMEOUT_MS="10000"

# ── NOWPayments crypto checkout (optional) ─────────────────────────────────
# Keep both secrets server-side. The callback URL must be publicly reachable.
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_IPN_CALLBACK_URL="https://api.example.com/api/webhooks/nowpayments"
NOWPAYMENTS_DEFAULT_PAY_CURRENCY=""
NOWPAYMENTS_FEE_PAID_BY_USER="false"
NOWPAYMENTS_FIXED_RATE="false"
# Override only if the account supports a different set of price currencies.
NOWPAYMENTS_SUPPORTED_PRICE_CURRENCIES="USD,NGN,EUR,GBP,CAD,AUD,INR,PHP,ZAR"

# ── Email (SMTP / transactional providers) ───────
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@makechurcheazy.com"
EMAIL_FROM_NAME="MakeChurchEasy"
EMAIL_REPLY_TO=""
SUPPORT_EMAIL="support@makechurcheazy.com"
# Production provider: mailtrap, resend, or console. Leave unset to auto-detect.
EMAIL_PROVIDER="mailtrap"
# Optional fallback provider. Leave empty to avoid duplicate-send risk.
EMAIL_FALLBACK_PROVIDER=""
MAILTRAP_API_TOKEN=""
# Use a verified Mailtrap sending domain in production. The Mailtrap demo address
# is suitable only for a first integration test.
MAILTRAP_FROM_EMAIL=""
MAILTRAP_FROM_NAME="MakeChurchEasy"
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_UNSUBSCRIBE_SECRET=""

# ── R2 Storage (Cloudflare) ─────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
R2_PUBLIC_BASE_URL=""
R2_PREFIX=""

# ── Analytics ───────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_GA_ID=""

# ── Telegram notifications (optional) ──────────
# Create a bot with BotFather, then set the private token and destination chat ID.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_NOTIFICATIONS_ENABLED="true"
TELEGRAM_NOTIFICATION_TIMEZONE="Africa/Lagos"
# API errors are reported to the same MakeChurchEasy Alerts chat. Repeated
# identical errors are grouped for this many milliseconds to prevent alert floods.
TELEGRAM_API_ERROR_ALERTS_ENABLED="true"
TELEGRAM_API_ERROR_COOLDOWN_MS="60000"

# ── AI / OpenCode ───────────────────────────────
OPENCODE_API_KEY=""
OPENCODE_MODEL="mimo-v2.5-free"
OPENCODE_MAX_TOKENS=""
OPENCODE_TIMEOUT_MS=""

# ── Scheduled Jobs ──────────────────────────────
# Used to authenticate Cloudflare cron requests.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ── Subscription ────────────────────────────────
SUBSCRIPTION_PRIVATE_KEY=""
