# ── Environment ──
VITE_APP_ENV=development           # "development" or "production"

# ── API endpoints ──
VITE_AUTH_API_URL=http://localhost:3004   # Auth + backend API
VITE_API_BASE_URL=http://localhost:3004   # API base URL
VITE_WS_URL=ws://localhost:3004           # WebSocket relay URL
VITE_SUBSCRIPTION_PUBLIC_KEY=             # Ed25519 public key used to verify subscription cache payloads

# ── AssemblyAI (speech-to-text) ──
VITE_ASSEMBLYAI_API_KEYS=

# ── Analytics ──
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_TOKEN=

# ── Dashboard website (optional) ──
# Plans/claim links open https://makechurcheazy.com by default, even with a local API.
# Set this only if you run the dashboard locally and want those links to open it.
# VITE_DASHBOARD_URL=http://localhost:4000
