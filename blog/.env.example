NEXT_PUBLIC_SITE_URL=https://blog.makechurcheazy.com

# Shared secret used by the AI/content automation when calling the write API.
BLOG_API_TOKEN=replace-with-a-long-random-secret

# Production content storage. The API commits Markdown files to this GitHub repo,
# and that commit triggers a Vercel rebuild.
GITHUB_CONTENT_TOKEN=replace-with-a-github-token
CONTENT_REPOSITORY_OWNER=your-github-username-or-organization
CONTENT_REPOSITORY_NAME=makechurcheasy-blog
CONTENT_REPOSITORY_BRANCH=main
